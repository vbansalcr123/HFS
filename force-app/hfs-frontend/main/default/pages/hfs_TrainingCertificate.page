<apex:page
  controller="hfs_TrainingController"
  showHeader="false"
  sidebar="false"
  applyHtmlTag="true"
  applyBodyTag="true"
  title="Training Certificate"
>
  <html>
    <head>
      <style type="text/css">
        body {
          font-family: "Public Sans", Arial, sans-serif;
          color: #12283f;
          margin: 0;
          background: #eef0f3;
        }
        .hfs-cert-wrap {
          max-width: 820px;
          margin: 2.5rem auto;
          padding: 0 1rem;
        }
        .hfs-cert {
          background: #ffffff;
          border: 4px solid #12283f;
          border-radius: 10px;
          padding: 3rem 2.5rem;
          text-align: center;
        }
        .hfs-cert-accent {
          height: 6px;
          background: #c8102e;
          border-radius: 4px;
          width: 120px;
          margin: 0 auto 1.5rem;
        }
        .hfs-cert-kicker {
          text-transform: uppercase;
          letter-spacing: 0.12em;
          font-size: 0.85rem;
          color: #5f6b7a;
          margin: 0;
        }
        .hfs-cert-title {
          font-size: 2rem;
          font-weight: 700;
          margin: 0.5rem 0 1.75rem;
        }
        .hfs-cert-name {
          font-size: 1.6rem;
          font-weight: 700;
          color: #12283f;
          margin: 0.25rem 0;
        }
        .hfs-cert-course {
          font-size: 1.2rem;
          color: #2a6fd1;
          font-weight: 600;
          margin: 0.75rem 0;
        }
        .hfs-cert-meta {
          font-size: 0.95rem;
          color: #5f6b7a;
          margin: 1.5rem 0 0;
        }
        .hfs-cert-empty {
          background: #fbe9e9;
          border: 1px solid #f3c5c5;
          border-radius: 8px;
          padding: 2rem;
          text-align: center;
          color: #8c1d1d;
        }
      </style>
    </head>
    <body>
      <div class="hfs-cert-wrap">
        <apex:outputPanel rendered="{!hasCertificate}" layout="none">
          <div class="hfs-cert">
            <div class="hfs-cert-accent"></div>
            <p class="hfs-cert-kicker">
              Sinclair Partner Portal &#8226; Certificate of Completion
            </p>
            <h1 class="hfs-cert-title">Certificate of Completion</h1>
            <p class="hfs-cert-kicker">This certifies that</p>
            <p class="hfs-cert-name">{!$User.FirstName} {!$User.LastName}</p>
            <p class="hfs-cert-kicker">has successfully completed</p>
            <p class="hfs-cert-course">{!certificate.title}</p>
            <p class="hfs-cert-meta">
              Completed on
              <apex:outputText value="{0,date,long}"
                ><apex:param value="{!certificate.completionDate}"
              /></apex:outputText>
            </p>
          </div>
        </apex:outputPanel>
        <apex:outputPanel rendered="{!NOT(hasCertificate)}" layout="none">
          <div class="hfs-cert-empty">
            <p>No certificate is available for your account for this course.</p>
          </div>
        </apex:outputPanel>
      </div>
    </body>
  </html>
</apex:page>
