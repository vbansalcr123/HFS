<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Contact Management</label>
    <description>Grants access to the Contact-related Apex classes and object/field permissions needed to run contact email validation.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <classAccesses>
        <apexClass>ContactSelector</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>ContactEmailValidationService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <objectPermissions>
        <object>Contact</object>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <fieldPermissions>
        <field>Contact.HasOptedOutOfEmail</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
</PermissionSet>
