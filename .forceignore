# List files or directories below to ignore them when running force:source:push, force:source:pull, and force:source:status
# More information: https://developer.salesforce.com/docs/atlas.en-us.sfdx_dev.meta/sfdx_dev/sfdx_dev_exclude_source.htm
#

package.xml

# LWC configuration files
**/jsconfig.json
**/.eslintrc.json

# LWC Jest
**/__tests__/**

node_modules/

# Placeholder files keeping otherwise-empty scaffold folders tracked in git — not real metadata.
# sfdx-git-delta infers a component's type/name purely from its path, isn't .gitkeep-aware, and
# will misread e.g. permissionsets/.gitkeep as a PermissionSet named "default" (the folder above
# it) or staticresources/.gitkeep as a StaticResource literally named ".gitkeep" — producing
# package.xml entries deploy validation then rejects with "named in package.xml but not found in
# zipped directory". See deploy.yml's "Compute Delta" step, which points sfdx-git-delta at this
# file via --ignore.
**/.gitkeep
